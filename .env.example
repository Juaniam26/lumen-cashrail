CASHRAIL_DATABASE_URL=postgresql+psycopg://cashrail@db/cashrail
CASHRAIL_CONTROLLER_TOKEN=replace-with-a-random-32-plus-character-secret
CASHRAIL_ENABLE_LIVE_EXECUTION=false
CASHRAIL_STRIPE_WEBHOOK_SECRET=replace-with-vault-reference-at-deploy-time
CASHRAIL_ENVIRONMENT=production
CASHRAIL_AUTO_CREATE_SCHEMA=false
CASHRAIL_CONTROLLER_POLICY_VERSION=cashrail-v1
CASHRAIL_CONTROLLER_ALLOWED_ACTIONS=PUBLIC_RESEARCH,INTERNAL_SCORING,DRAFT_OUTREACH,DRAFT_PROPOSAL
